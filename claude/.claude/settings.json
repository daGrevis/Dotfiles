{
  "model": "opus",
  "tui": "default",
  "env": {
    "DISABLE_UPDATES": "1"
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Bash(curl:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/sh/update-claude-usage-tmux.sh"
          },
          {
            "type": "command",
            "command": "[ -f ~/Dropbox/claude-memory.md ] && cat ~/Dropbox/claude-memory.md || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); sid=$(echo \"$input\" | jq -r '.session_id // empty'); date +%s > /tmp/.claude-prompt-start-${sid:-default}; rm -f /tmp/.claude-prompt-pause-${sid:-default}"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/sh/claude-notify.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/sh/claude-notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/sh/update-claude-usage-tmux.sh"
          },
          {
            "type": "command",
            "command": "~/sh/claude-notify.sh"
          }
        ]
      }
    ]
  }
}
